msgstr "Buscando imágenes en los medios."

#: src/flash.c
msgid "Images"
msgstr "Imágenes"

#: src/flash.c
msgid "Distribution"
msgstr "Distribución"

#: src/flash.c
msgid "Which distribution should the images come from?"
msgstr "¿De qué distribución deberían provenir las imágenes?"

#: src/flash.c
#, c-format
msgid "Downloading %s"
msgstr "Descargando %s"

#: src/flash.c
#, c-format
msgid "%lld of %lld MB"
msgstr "%lld de %lld MB"

#: src/flash.c
