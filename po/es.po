msgstr "Enviar informe de crash"

#: src/main.c src/plugins.c
msgid "Disable plugins"
msgstr "Deshabilitar plugins"

#: src/main.c src/update.c
msgid "Software update"
msgstr "Actualización de software"

#: src/main.c src/reset.c
msgid "Reset settings"
msgstr "Restablecer configuración"

#: src/main.c src/backup.c
msgid "Back up image"
msgstr "Copia de Imagen"

#: src/main.c src/flash.c
msgid "Flash online/local"
msgstr "Flash en línea/local"

#: src/main.c src/slots.c
msgid "Boot another slot"
msgstr "Arrancar en otro slot"

#: src/main.c
msgid "Starts Enigma2 again. If a plugin keeps it from starting, disable the plugin first."
msgstr "Inicia Enigma2 nuevamente. Si un plugin impide que se inicie, desactívelo primero."

#: src/main.c
msgid "Shows the newest crash log of Enigma2. BLUE shows the steps of the last start."
msgstr "Muestra el registro de crash más reciente de Enigma2. AZUL muestra los pasos del último inicio."

#: src/main.c
msgid "Keeps Enigma2 from loading a plugin, temporarily or permanently, and enables it again. A plugin that caused problems at the last start is marked and chosen at first."
msgstr "Evita que Enigma2 cargue un plugin, temporal o permanentemente, y lo habilita nuevamente. Un plugin que causó problemas en el último inicio se marca y se elige al principio."

#: src/main.c
msgid "Installs the latest updates for your receiver. You see the list and confirm before anything is installed."
msgstr "Instala las últimas actualizaciones para su receptor. Verá la lista y confirmará antes de instalar algo."

#: src/main.c
msgid "Resets the skin, the settings or all of Enigma2 to the state of a new installation. Your old settings are moved aside, so nothing is deleted for good."
msgstr "Restablece la skin, la configuración o todo Enigma2 al estado de una nueva instalación. Tus configuraciones anteriores se dejan a un lado, por lo que no se elimina nada para siempre."

#: src/main.c
msgid "Saves the running image as a zip file on a USB stick or hard disk, so it can be flashed again later."
msgstr "Guarda la imagen en ejecución como un archivo zip en una memoria USB o disco duro, para poder actualizarla nuevamente más tarde."

#: src/main.c
msgid "Flashes an image into the running slot, from the feed of the running distribution or from the media. A check with ofgwrite tests the image before anything is written."
msgstr "Muestra una imagen en el slot en ejecución, desde el feed de la distribución en ejecución o desde los medios. Una verificación con ofgwrite prueba la imagen antes de escribir algo."

#: src/main.c
msgid "Restarts the receiver with the image of another slot."
msgstr "Reinicia el receptor con la imagen de otro slot."

#: src/main.c
msgid "Ends the Open Recovery Manager. Enigma2 stays stopped."
msgstr "Finaliza Open Recovery Manager. Enigma2 permanece detenido."

#: src/main.c
#, c-format
msgid "Newest crash log: %s"
msgstr "Registro de crash más reciente: %s"

#. TRANSLATORS: %s is the distribution, e.g. OpenATV.
#: src/main.c
#, c-format
msgid "Sends the crash report to the %s ticket system, so the developers can find the error. You see everything before it is sent."
msgstr "Envía el informe de fallo al sistema de tickets de %s, para que los desarrolladores puedan encontrar el error. Puedes ver todo antes de enviarlo."

#: src/main.c
#, c-format
msgid "Restart in %d s, any key cancels"
msgstr "Reinicia en %d s, cualquier tecla se cancela"

#: src/main.c src/language.c
msgid "Language"
msgstr "Idioma"

