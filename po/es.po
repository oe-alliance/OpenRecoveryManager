msgstr "Apagado"

#: src/main.c
#, c-format
msgid ""
"%s %s (%s)\n"
"%s %s, build %s (%s)\n"
"Enigma2 revision %s"
msgstr ""
"%s %s (%s)\n"
"%s %s, build %s (%s)\n"
"Revisión de Enigma2 %s"

#: src/main.c
msgid "Exit"
msgstr "Salida"

#: src/remote.c
msgid "End the Remote Support session? The supporter can then no longer work on the receiver."
msgstr "¿Finalizar la sesión de Soporte Remoto? El seguidor ya no podrá trabajar con el receptor."

#: src/remote.c src/flash.c src/backup.c
msgid "Cancel"
msgstr "Cancelar"

#: src/remote.c
msgid "Starting the Remote Support session."
msgstr "Iniciando la sesión de Soporte Remoto."

#: src/remote.c
msgid "Connecting to the support server, this takes a few seconds."
msgstr "Conectarse al servidor de soporte, esto demora unos segundos."

#: src/remote.c
msgid "Scan the QR code with your phone and send the link to your supporter from there."
msgstr "Escanea el código QR con tu teléfono y envía el enlace a tu seguidor desde allí."

#: src/remote.c
msgid "Send the link below to your supporter or let them scan the QR code."
msgstr "Envía el siguiente enlace a tu seguidor o déjale escanear el código QR."

#: src/remote.c
msgid "Approved users can open terminals. Everybody who joins later has to be approved as well."
msgstr "Los usuarios aprobados pueden abrir terminales. Todos los que se unan más tarde también deben ser aprobados."

#: src/remote.c
msgid "When somebody joins the session, you have to approve the access with the remote control."
msgstr "Cuando alguien se une a la sesión, hay que aprobar el acceso con el mando a distancia."

#: src/remote.c
msgid "The session keeps running in the menu and ends when Enigma2 starts."
msgstr "La sesión continúa ejecutándose en el menú y finaliza cuando se inicia Enigma2."

#: src/remote.c
msgid "The session keeps running in the menu and after Enigma2 starts."
msgstr "La sesión continúa ejecutándose en el menú y después de que se inicia Enigma2."

#: src/remote.c
msgid "Ending the session..."
msgstr "Terminando la sesión..."

#: src/remote.c
msgid "End session"
msgstr "Finalizar sesión"

#: src/remote.c
msgid "Do not post the link or a screenshot of it in public forums: everybody who has it can try to join and sees the terminals until you deny the access."
msgstr "No publiques el enlace ni una captura de pantalla del mismo en foros públicos: cualquiera que lo tenga puede intentar unirse y ver los terminales hasta que le niegues el acceso."

#: src/remote.c
msgid "Scan with your phone to send the link to your supporter"
msgstr "Escanee con su teléfono para enviar el enlace a su seguidor"

#: src/remote.c
msgid "Scan to open the support session"
msgstr "Escanee para abrir la sesión de soporte"

#: src/remote.c
#, c-format
msgid ""
"Users: %s\n"
"Terminals: %d"
msgstr ""
"Usuarios: %s\n"
"Finales: %d"

#: src/remote.c
msgid "Not installed, it goes into RAM until the next restart, the flash stays as it is. Please wait..."
msgstr "No instalado, pasa a la RAM hasta el próximo reinicio, el flash permanece como está. Espere por favor..."

#: src/remote.c
msgid "Installing into RAM"
msgstr "Instalación en RAM"

#: src/remote.c
msgid "Remote Support could not be installed."
msgstr "No se pudo instalar el soporte remoto."

#: src/remote.c
msgid "Remote Support cannot be started."
msgstr "No se puede iniciar el soporte remoto."

#: src/remote.c
msgid "Start Remote Support? A supporter can then work on the receiver from the internet."
msgstr "¿Iniciar soporte remoto? Un colaborador podrá entonces trabajar en el receptor desde Internet."

#: src/remote.c
msgid "The Remote Support session ended."
msgstr "La sesión de Soporte Remoto finalizó."

#: src/reset.c
#, c-format
msgid "%s cannot be saved: %s"
msgstr "%s no se puede guardar: %s"

#: src/reset.c
#, c-format
msgid "%s cannot be created: %s"
msgstr "%s no se puede crear: %s"

#: src/reset.c
#, c-format
msgid "%s cannot be changed: %s"
msgstr "%s no se puede cambiar: %s"

#: src/reset.c src/plugins.c
#, c-format
msgid "%s cannot be moved: %s"
msgstr "%s no se puede mover: %s"

#: src/reset.c
msgid "Only the skin (all other settings stay)"
msgstr "Sólo la skin (todas las demás configuraciones permanecen)"

#: src/reset.c
msgid "Only the settings (channel lists and timers stay)"
msgstr "Solo se mantienen los ajustes (listas de canales y temporizadores)"

#: src/reset.c
msgid "Everything, including channel lists and timers"
msgstr "Todo, incluidas listas de canales y temporizadores"

#: src/reset.c
#, c-format
msgid "What should be reset? After the settings or everything, Enigma2 starts with the wizard, which offers to restore a backup. The files are kept in a folder next to %s, the network settings stay."
msgstr "¿Qué se debe restablecer? Después de la configuración o todo, Enigma2 comienza con el asistente, que ofrece restaurar una copia de seguridad. Los archivos se guardan en una carpeta junto a %s, la configuración de red permanece."

#: src/reset.c
msgid "Reset"
msgstr "Restablecer"

#: src/reset.c
msgid "Reset the skin now? Enigma2 then starts with its standard skin, all other settings stay. Your old settings are kept."
msgstr "¿Restablecer la skin ahora? Luego, Enigma2 comienza con su skin estándar, todas las demás configuraciones permanecen. Se mantienen sus configuraciones anteriores."

#: src/reset.c
msgid "Reset the settings now? Your channel lists and timers stay, all other settings start from the beginning. Your old settings are kept."
msgstr "¿Restablecer la configuración ahora? Tus listas de canales y temporizadores permanecen, todas las demás configuraciones comienzan desde el principio. Se mantienen sus configuraciones anteriores."

#: src/reset.c
msgid "Reset everything now? Enigma2 then starts like new, without channel lists and timers. Your old files are kept."
msgstr "¿Restablecer todo ahora? Enigma2 comienza entonces como nuevo, sin listas de canales ni temporizadores. Sus archivos antiguos se conservan."

#: src/reset.c
#, c-format
msgid "The skin was reset, the old settings are kept in %s."
msgstr "La skin se restableció, la configuración anterior se mantiene en %s."

#: src/reset.c
#, c-format
msgid "The settings were reset, the old file is kept in %s."
msgstr "La configuración se restableció, el archivo antiguo se mantiene en %s."

#: src/reset.c
#, c-format
msgid "The files of Enigma2 were reset, the old ones are kept in %s."
msgstr "Los archivos de Enigma2 fueron reseteados, los antiguos se mantienen en %s."

#: src/reset.c
msgid "Restart Enigma2 in the menu to start with the standard skin."
msgstr "Reinicie Enigma2 en el menú para comenzar con la skin estándar."

#: src/reset.c
msgid "Restart Enigma2 in the menu to start with the wizard."
msgstr "Reinicie Enigma2 en el menú para comenzar con el asistente."

#: src/flash.c
msgid "Backup images"
msgstr "Copias de imágenes"

#: src/flash.c
msgid "Local images"
msgstr "Imágenes locales"

#: src/flash.c
