#: src/main.c
msgid "STARTED FROM THE CONSOLE"
msgstr "COMENZADO DESDE LA CONSOLA"

#: src/main.c
msgid "Enigma2 is stopped"
msgstr "Enigma2 está detenido"

#: src/main.c
msgid "Recovery Manager runs from a console session. After it ends, Enigma2 can be started again with init 3."
msgstr "Recovery Manager se ejecuta desde una sesión de consola. Una vez finalizado, Enigma2 se puede iniciar nuevamente con init 3."

#: src/main.c
msgid "OPENED FROM THE MENU"
msgstr "ABIERTO DESDE EL MENÚ"

#: src/main.c
msgid "Enigma2 is paused"
msgstr "Enigma2 está en pausa"

#: src/main.c
msgid "Recovery Manager was opened from the menu. After it ends, Enigma2 starts again on its own."
msgstr "Se abrió Recovery Manager desde el menú. Una vez finalizado, Enigma2 comienza de nuevo por sí solo."

#: src/main.c
msgid "ENIGMA2 STOPPED RESPONDING WHILE STARTING"
msgstr "ENIGMA2 DEJÓ DE RESPONDER AL INICIAR"

#: src/main.c
msgid "ENIGMA2 STOPPED WITH A PYTHON ERROR SHORTLY AFTER THE START"
msgstr "ENIGMA2 SE DETUVO CON UN ERROR DE PYTHON POCO DESPUÉS DEL INICIO"

#: src/main.c
msgid "ENIGMA2 STOPPED WITH A PYTHON ERROR WHILE STARTING"
msgstr "ENIGMA2 SE DETUVO CON UN ERROR DE PYTHON AL INICIAR"

#: src/main.c
msgid "ENIGMA2 CRASHED SHORTLY AFTER THE START"
msgstr "ENIGMA2 CRASHEO POCO DESPUÉS DEL INICIO"

#: src/main.c
msgid "ENIGMA2 CRASHED WHILE STARTING"
msgstr "ENIGMA2 CRASHEO AL ARRANCAR"

