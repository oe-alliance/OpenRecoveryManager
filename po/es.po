msgstr "Registro de crash"

#: src/main.c
msgid "There is no log of the last start."
msgstr "No hay ningún registro del último inicio."

#: src/main.c
msgid "There is no crash log."
msgstr "No hay ningún registro de crash."

#: src/main.c
msgid "Restart Enigma2"
msgstr "Reiniciar Enigma2"

#: src/main.c
msgid "Show crash log"
msgstr "Mostrar registro de crash"

#: src/main.c
