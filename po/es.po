#: src/flash.c
#, c-format
msgid "Unzipping %s"
msgstr "Descomprimiendo %s"

#: src/flash.c
msgid "Check"
msgstr "Chequeo"

#: src/flash.c
msgid "Please wait, ofgwrite checks the image..."
msgstr "Espere, ofgwrite comprueba la imagen..."

#: src/flash.c
msgid "the running image"
msgstr "la imagen corriendo"

#: src/flash.c
#, c-format
msgid "%s (%s on %s), the running image"
msgstr "%s (%s en %s), la imagen en ejecución"

#: src/flash.c
#, c-format
msgid "%s (%s), the running image"
msgstr "%s (%s), la imagen en ejecución"

#: src/flash.c
msgid "Flashing finished, restart the receiver in the menu."
msgstr "Terminado el parpadeo, reinicia el receptor en el menú."

#: src/flash.c
#, c-format
msgid "Flashing failed, see %s."
msgstr "Error al flashear, ver %s."

#: src/flash.c
msgid "ofgwrite wrote nothing."
msgstr "ofgwrite no escribió nada."

#: src/flash.c
msgid "Flashing"
msgstr "Flasheando"

#: src/flash.c
msgid "flashed too, kernel A of all slots"
msgstr "también flasheado, el núcleo A de todas los slots"

#: src/flash.c
#, c-format
msgid "flashed too (%s)"
msgstr "flasheado también (%s)"

#: src/flash.c
msgid "flashed too"
msgstr "flasheado también"

#: src/flash.c
msgid "stays as it is"
msgstr "se queda como esta"

#: src/flash.c
msgid "Image"
msgstr "Imagen"

#: src/flash.c
msgid "Location"
msgstr "Ubicación"

#: src/flash.c
msgid "Slot"
msgstr "Slot"

#: src/flash.c
msgid "Kernel"
msgstr "Kernel"

#: src/flash.c
msgid "Command"
msgstr "Comando"

#: src/flash.c
msgid "The check was successful"
msgstr "El chequeo fue exitoso"

#: src/flash.c
msgid "The check failed"
msgstr "El chequeo falló"

#: src/flash.c
msgid "Flash now"
msgstr "Flashear ahora"

#: src/flash.c
msgid "Flash the image now? The running image is replaced and the receiver restarts. Do not switch it off while it flashes."
msgstr "¿Mostrar la imagen ahora? La imagen en ejecución se reemplaza y el receptor se reinicia. No lo apagues mientras flashea."

#: src/flash.c
msgid "Clean flash: all settings are lost, after the restart the most recent backup can be restored."
msgstr "Limpiar flash: se pierden todas las configuraciones, después del reinicio se puede restaurar la copia de seguridad más reciente."

#: src/flash.c
msgid "The check only tests the image and writes nothing. After a successful check, OK starts flashing."
msgstr "El cheque solo prueba la imagen y no escribe nada. Después de una verificación exitosa, OK comienza a flashear."

#: src/flash.c
#, c-format
msgid "There is not enough free space on %s, it needs %lld MB. YELLOW frees up space."
msgstr "No hay suficiente espacio libre en %s, necesita %lld MB. AMARILLO libera espacio."

#: src/flash.c src/backup.c src/files.c
msgid "Free up space"
msgstr "Liberar espacio"

#: src/flash.c
#, c-format
msgid "There is not enough free space on %s, it needs %lld MB."
msgstr "No hay suficiente espacio libre en %s, necesita %lld MB."

#: src/flash.c
msgid "The image could not be downloaded."
msgstr "La imagen no se pudo descargar."

#: src/flash.c
msgid "The image could not be unzipped or holds no image for ofgwrite."
msgstr "La imagen no se pudo descomprimir o no contiene ninguna imagen para ofgwrite."

#: src/flash.c
msgid "Loading the list of distributions."
msgstr "Cargando la lista de distribuciones."

#: src/flash.c
msgid "Close"
msgstr "Cerrar"

#: src/flash.c
msgid "The chosen image replaces the running image."
msgstr "La imagen elegida reemplaza la imagen en ejecución."

#: src/flash.c
#, c-format
msgid "The chosen image replaces the running image in slot %s (%s on %s)."
msgstr "La imagen elegida reemplaza la imagen en ejecución en el espacio %s (%s en %s)."

#: src/flash.c
#, c-format
msgid "The chosen image replaces the running image in slot %s (%s)."
msgstr "La imagen elegida reemplaza la imagen en ejecución en el espacio %s (%s)."

#: src/flash.c
#, c-format
msgid "%s%s Downloaded images are saved on the USB stick (%s/images)."
msgstr "%s%s Las imágenes descargadas se guardan en la memoria USB (%s/images)."

#: src/flash.c
#, c-format
msgid "%s%s Downloaded images are saved on the hard disk (%s/images)."
msgstr "%s%s Las imágenes descargadas se guardan en el disco duro (%s/images)."

#: src/flash.c
msgid "The images of the distribution could not be loaded. "
msgstr "No se pudieron cargar las imágenes de la distribución. "

#: src/flash.c
msgid "ofgwrite is not installed, an image cannot be flashed."
msgstr "ofgwrite no está instalado, no se puede flashear una imagen."

#: src/flash.c
msgid "Neither /media/hdd nor /media/usb is mounted, the image needs one of them. Please attach a USB stick or a hard disk."
msgstr "Ni /media/hdd ni /media/usb están montados, la imagen necesita uno de ellos. Adjunte una memoria USB o un disco duro."

#: src/flash.c
msgid "Looking for the running slot."
msgstr "Buscando el slot para funcionamiento."

#: src/backup.c
#, c-format
msgid "%s\t%lld MB"
msgstr "%s %lld MB"

#: src/backup.c
msgid "Medium"
msgstr "Medio"

#: src/backup.c
msgid "Free"
msgstr "Libre"

#: src/backup.c
#, c-format
msgid "There is not enough free space on any medium. The backup needs about %lld MB. YELLOW frees up space on the chosen medium."
msgstr "No hay suficiente espacio libre en ningún medio. La copia de seguridad necesita aproximadamente %lld MB. AMARILLO libera espacio en el medio elegido."

#: src/backup.c
#, c-format
msgid "Saves the running image as a zip file, which Flash online/local can flash again. It needs about %lld MB. Where should it be saved?"
msgstr "Guarda la imagen en ejecución como un archivo zip, que Flash en línea/local puede flashear nuevamente. Necesita aproximadamente %lld MB. ¿Dónde debería guardarse?"

#: src/backup.c
msgid "Back up"
msgstr "Respaldo"

#: src/backup.c
msgid "Cancel the backup? What is done so far is deleted."
msgstr "¿Cancelar la copia de seguridad? Se elimina lo hecho hasta el momento."

#: src/backup.c
msgid "Measuring the running image."
msgstr "Medición de la imagen en ejecución."

#: src/backup.c
msgid "No medium is mounted, the backup needs a USB stick or a hard disk."
msgstr "No hay ningún medio montado, la copia de seguridad necesita una memoria USB o un disco duro."

#: src/backup.c
msgid "The backup cannot be prepared."
msgstr "No se puede preparar la copia de seguridad."

#: src/backup.c src/update.c
msgid "Please wait, do not switch off the receiver..."
msgstr "Por favor espera, no apagues el receptor..."

#: src/backup.c
#, c-format
msgid "The backup is saved as %s/images/%s."
msgstr "La copia de seguridad se guarda como %s/images/%s."

#: src/backup.c
msgid "The backup was cancelled."
msgstr "La copia de seguridad fue cancelada."

#: src/backup.c
