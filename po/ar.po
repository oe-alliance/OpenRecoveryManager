msgstr "إرسال تقرير العطل"

#: src/main.c src/plugins.c
msgid "Disable plugins"
msgstr "تعطيل الإضافات"

#: src/main.c src/update.c
msgid "Software update"
msgstr "تحديث البرامج"

#: src/main.c src/reset.c
msgid "Reset settings"
msgstr "إعادة ضبط الإعدادات"

#: src/main.c src/backup.c
msgid "Back up image"
msgstr "نسخ الصورة احتياطيًا"

#: src/main.c src/flash.c
msgid "Flash online/local"
msgstr "تثبيت صورة عبر الإنترنت/محليًا"

#: src/main.c src/slots.c
msgid "Boot another slot"
msgstr "الإقلاع من فتحة أخرى"

#: src/main.c
msgid ""
"Starts Enigma2 again. If a plugin keeps it from starting, disable the plugin "
"first."
msgstr "يعيد تشغيل Enigma2. إذا كانت إضافة تمنع التشغيل، فعطّلها أولاً."

#: src/main.c
msgid ""
"Shows the newest crash log of Enigma2. BLUE shows the steps of the last "
"start."
msgstr "يعرض أحدث سجل أعطال لـ Enigma2. يعرض BLUE خطوات آخر تشغيل."

#: src/main.c
msgid ""
"Keeps Enigma2 from loading a plugin, temporarily or permanently, and enables "
"it again. A plugin that caused problems at the last start is marked and "
"chosen at first."
msgstr ""
"يمنع Enigma2 من تحميل إضافة، مؤقتًا أو بشكل دائم، ويفعّلها مرة أخرى. الإضافة "
"التي سببت مشاكل في آخر تشغيل تكون مميزة ومحددة مسبقًا."

#: src/main.c
msgid ""
"Installs the latest updates for your receiver. You see the list and confirm "
"before anything is installed."
msgstr "يثبّت أحدث التحديثات لجهازك. سترى القائمة وتؤكد قبل تثبيت أي شيء."

#: src/main.c
msgid ""
"Resets Enigma2 to the state of a new installation. Your old settings are "
"moved aside, so nothing is deleted for good."
msgstr ""
"يعيد Enigma2 إلى حالة التثبيت الجديد. يتم نقل إعداداتك القديمة جانبًا، فلا "
"يُحذف شيء نهائيًا."

#: src/main.c
msgid ""
"Saves the running image as a zip file on a USB stick or hard disk, so it can "
"be flashed again later."
msgstr ""
"يحفظ الصورة الحالية كملف zip على ذاكرة USB أو قرص صلب، ليمكن تثبيتها مجددًا "
"لاحقًا."

#: src/main.c
msgid ""
"Flashes an image into the running slot, from the feed of the running "
"distribution or from the media. A check with ofgwrite tests the image before "
"anything is written."
msgstr ""
"يثبّت صورة نظام في الفتحة الحالية، من مصدر التوزيعة الحالية أو من وسائط "
"التخزين. يختبر فحص بواسطة ofgwrite الصورة قبل كتابة أي شيء."

#: src/main.c
msgid "Restarts the receiver with the image of another slot."
msgstr "يعيد تشغيل الجهاز بصورة النظام من فتحة أخرى."

#: src/main.c
msgid "Ends the Open Recovery Manager. Enigma2 stays stopped."
msgstr "يُنهي Open Recovery Manager. يبقى Enigma2 متوقفًا."

#: src/main.c
#, c-format
msgid "Newest crash log: %s"
msgstr "أحدث سجل أعطال: %s"

#. TRANSLATORS: %s is the distribution, e.g. OpenATV.
#: src/main.c
#, c-format
msgid ""
"Sends the crash report to the %s ticket system, so the developers can find "
"the error. You see everything before it is sent."
msgstr ""
"يرسل تقرير العطل إلى نظام التذاكر لدى %s، حتى يتمكن المطورون من إيجاد الخطأ. "
"سترى كل شيء قبل إرساله."

#: src/main.c
#, c-format
msgid "Restart in %d s, any key cancels"
msgstr "إعادة التشغيل خلال %d ث، أي زر يلغيها"

#: src/main.c src/language.c
msgid "Language"
msgstr "اللغة"

#: src/main.c src/flash.c src/files.c
msgid "Open"
msgstr "فتح"

#: src/main.c src/flash.c src/language.c
msgid "Choose"
msgstr "اختيار"

#: src/main.c src/remote.c
msgid "Remote Support"
msgstr "Remote Support"

#: src/main.c src/about.c
msgid "About"
msgstr "حول"

#: src/main.c
msgid "Reboot"
msgstr "إعادة التشغيل"

#: src/main.c
msgid "Shutdown"
msgstr "إيقاف التشغيل"

#: src/main.c
#, c-format
msgid ""
"%s %s (%s)\n"
"%s %s, build %s (%s)\n"
"Enigma2 revision %s"
msgstr ""
"%s %s (%s)\n"
"%s %s، الإصدار %s (%s)\n"
"مراجعة Enigma2 %s"

#: src/main.c
msgid "Exit"
msgstr "خروج"

#: src/remote.c
msgid ""
"End the Remote Support session? The supporter can then no longer work on the "
"receiver."
msgstr ""
"إنهاء جلسة Remote Support؟ لن يتمكن فني الدعم عندها من العمل على الجهاز."

#: src/remote.c src/flash.c src/backup.c
msgid "Cancel"
msgstr "إلغاء"

#: src/remote.c
msgid "Starting the Remote Support session."
msgstr "جارٍ بدء جلسة Remote Support."

#: src/remote.c
msgid "Connecting to the support server, this takes a few seconds."
msgstr "جارٍ الاتصال بخادم الدعم، يستغرق ذلك بضع ثوانٍ."

#: src/remote.c
msgid ""
"Scan the QR code with your phone and send the link to your supporter from "
"there."
msgstr "امسح رمز QR بهاتفك وأرسل الرابط من هناك إلى فني الدعم."

#: src/remote.c
msgid "Send the link below to your supporter or let them scan the QR code."
msgstr "أرسل الرابط أدناه إلى فني الدعم أو دعه يمسح رمز QR."

#: src/remote.c
msgid ""
"Approved users can open terminals. Everybody who joins later has to be "
"approved as well."
msgstr ""
"يمكن للمستخدمين الموافق عليهم فتح الطرفيات. كل من ينضم لاحقًا يحتاج إلى "
"موافقة أيضًا."

#: src/remote.c
msgid ""
"When somebody joins the session, you have to approve the access with the "
"remote control."
msgstr ""
"عندما ينضم أحد إلى الجلسة، عليك الموافقة على الوصول بجهاز التحكم عن بُعد."

#: src/remote.c
msgid "The session keeps running in the menu and ends when Enigma2 starts."
msgstr "تستمر الجلسة في القائمة وتنتهي عند تشغيل Enigma2."

#: src/remote.c
msgid "The session keeps running in the menu and after Enigma2 starts."
msgstr "تستمر الجلسة في القائمة وبعد تشغيل Enigma2."

#: src/remote.c
msgid "Ending the session..."
msgstr "جارٍ إنهاء الجلسة..."

#: src/remote.c
msgid "End session"
msgstr "إنهاء الجلسة"

#: src/remote.c
msgid ""
"Do not post the link or a screenshot of it in public forums: everybody who "
"has it can try to join and sees the terminals until you deny the access."
msgstr ""
"لا تنشر الرابط أو لقطة شاشة له في المنتديات العامة: كل من لديه الرابط يمكنه "
"محاولة الانضمام ويرى الطرفيات حتى ترفض الوصول."

#: src/remote.c
msgid "Scan with your phone to send the link to your supporter"
msgstr "امسح بهاتفك لإرسال الرابط إلى فني الدعم"

#: src/remote.c
msgid "Scan to open the support session"
msgstr "امسح لفتح جلسة الدعم"

#: src/remote.c
#, c-format
msgid ""
"Users: %s\n"
"Terminals: %d"
msgstr ""
"المستخدمون: %s\n"
"الطرفيات: %d"

#: src/remote.c
msgid ""
"Not installed, it goes into RAM until the next restart, the flash stays as "
"it is. Please wait..."
msgstr ""
"غير مثبّت، سيُحمَّل في RAM حتى إعادة التشغيل التالية، وتبقى الذاكرة الداخلية كما "
"هي. يرجى الانتظار..."

#: src/remote.c
msgid "Installing into RAM"
msgstr "التثبيت في RAM"

#: src/remote.c
msgid "Remote Support could not be installed."
msgstr "تعذّر تثبيت Remote Support."

#: src/remote.c
msgid "Remote Support cannot be started."
msgstr "لا يمكن بدء Remote Support."

#: src/remote.c
msgid ""
"Start Remote Support? A supporter can then work on the receiver from the "
"internet."
msgstr ""
"بدء Remote Support؟ سيتمكن فني الدعم عندها من العمل على الجهاز عبر الإنترنت."

#: src/remote.c
msgid "The Remote Support session ended."
msgstr "انتهت جلسة Remote Support."

#: src/reset.c src/plugins.c
#, c-format
msgid "%s cannot be moved: %s"
msgstr "لا يمكن نقل %s: %s"

#: src/reset.c
#, c-format
msgid "%s cannot be created: %s"
msgstr "لا يمكن إنشاء %s: %s"

#: src/reset.c
msgid "Only the settings (channel lists and timers stay)"
msgstr "الإعدادات فقط (تبقى قوائم القنوات والمؤقتات)"

#: src/reset.c
msgid "Everything, including channel lists and timers"
msgstr "كل شيء، بما في ذلك قوائم القنوات والمؤقتات"

#: src/reset.c
#, c-format
msgid ""
"What should be reset? Enigma2 then starts with the wizard, which offers to "
"restore a backup. The files are kept in a folder next to %s, the network "
"settings stay."
msgstr ""
"ما الذي تريد إعادة ضبطه؟ سيبدأ Enigma2 بعدها بمعالج الإعداد الذي يعرض "
"استعادة نسخة احتياطية. تُحفظ الملفات في مجلد بجانب %s، وتبقى إعدادات الشبكة."

#: src/reset.c
msgid "Reset"
msgstr "إعادة ضبط"

#: src/reset.c
msgid ""
"Reset everything now? Enigma2 then starts like new, without channel lists "
"and timers. Your old files are kept."
msgstr ""
"إعادة ضبط كل شيء الآن؟ سيبدأ Enigma2 كأنه جديد، بدون قوائم القنوات "
"والمؤقتات. ستُحفظ ملفاتك القديمة."

#: src/reset.c
msgid ""
"Reset the settings now? Your channel lists and timers stay, all other "
"settings start from the beginning. Your old settings are kept."
msgstr ""
"إعادة ضبط الإعدادات الآن؟ تبقى قوائم القنوات والمؤقتات، وتبدأ كل الإعدادات "
"الأخرى من جديد. ستُحفظ إعداداتك القديمة."

#: src/reset.c
#, c-format
msgid "The files of Enigma2 were reset, the old ones are kept in %s."
msgstr "تمت إعادة ضبط ملفات Enigma2، والملفات القديمة محفوظة في %s."

#: src/reset.c
#, c-format
msgid "The settings were reset, the old file is kept in %s."
msgstr "تمت إعادة ضبط الإعدادات، والملف القديم محفوظ في %s."

#: src/reset.c
msgid "Restart Enigma2 in the menu to start with the wizard."
msgstr "أعد تشغيل Enigma2 من القائمة للبدء بمعالج الإعداد."

#: src/flash.c
msgid "Backup images"
msgstr "صور النسخ الاحتياطي"

#: src/flash.c
msgid "Local images"
msgstr "الصور المحلية"

#: src/flash.c
#, c-format
msgid "%d image"
msgid_plural "%d images"
msgstr[0] "%d صورة"
msgstr[1] "%d صورة"
msgstr[2] "%d صورة"
msgstr[3] "%d صور"
msgstr[4] "%d صورةً"
msgstr[5] "%d صورة"

#: src/flash.c
#, c-format
msgid "Distribution: %s"
msgstr "التوزيعة: %s"

#: src/flash.c
msgid "No images found"
msgstr "لم يتم العثور على صور"

#: src/flash.c
#, c-format
msgid "Loading the images of %s."
msgstr "جارٍ تحميل صور %s."

#: src/flash.c src/backup.c src/files.c src/crash.c src/slots.c src/update.c
#: src/viewer.c
msgid "Please wait..."
msgstr "يرجى الانتظار..."

#: src/flash.c
msgid "Looking for images on the media."
msgstr "جارٍ البحث عن صور على وسائط التخزين."

#: src/flash.c
msgid "Images"
msgstr "الصور"

#: src/flash.c
msgid "Distribution"
msgstr "التوزيعة"

#: src/flash.c
msgid "Which distribution should the images come from?"
msgstr "من أي توزيعة تريد الصور؟"

#: src/flash.c
#, c-format
msgid "Downloading %s"
msgstr "جارٍ تنزيل %s"

#: src/flash.c
#, c-format
msgid "%lld of %lld MB"
msgstr "%lld من %lld MB"

#: src/flash.c
#, c-format
msgid "%lld MB"
msgstr "%lld MB"

#: src/flash.c
#, c-format
msgid "Unzipping %s"
msgstr "جارٍ فك ضغط %s"

#: src/flash.c
msgid "Check"
msgstr "فحص"

#: src/flash.c
msgid "Please wait, ofgwrite checks the image..."
msgstr "يرجى الانتظار، ofgwrite يفحص الصورة..."

#: src/flash.c
msgid "the running image"
msgstr "الصورة الحالية"

#: src/flash.c
#, c-format
msgid "%s (%s on %s), the running image"
msgstr "%s (%s على %s)، الصورة الحالية"

#: src/flash.c
#, c-format
msgid "%s (%s), the running image"
msgstr "%s (%s)، الصورة الحالية"

#: src/flash.c
msgid "Flashing finished, restart the receiver in the menu."
msgstr "اكتمل التثبيت، أعد تشغيل الجهاز من القائمة."

#: src/flash.c
#, c-format
msgid "Flashing failed, see %s."
msgstr "فشل التثبيت، راجع %s."

#: src/flash.c
msgid "ofgwrite wrote nothing."
msgstr "لم يُخرج ofgwrite أي شيء."

#: src/flash.c
msgid "Flashing"
msgstr "التثبيت"

#: src/flash.c
msgid "flashed too, kernel A of all slots"
msgstr "يُثبَّت أيضًا، النواة A لكل الفتحات"

#: src/flash.c
#, c-format
msgid "flashed too (%s)"
msgstr "يُثبَّت أيضًا (%s)"

#: src/flash.c
msgid "flashed too"
msgstr "يُثبَّت أيضًا"

#: src/flash.c
msgid "stays as it is"
msgstr "يبقى كما هو"

#: src/flash.c
msgid "Image"
msgstr "الصورة"

#: src/flash.c
msgid "Location"
msgstr "الموقع"

#: src/flash.c
msgid "Slot"
msgstr "الفتحة"

#: src/flash.c
msgid "Kernel"
msgstr "النواة"

#: src/flash.c
msgid "Command"
msgstr "الأمر"

#: src/flash.c
msgid "The check was successful"
msgstr "نجح الفحص"

#: src/flash.c
msgid "The check failed"
msgstr "فشل الفحص"

#: src/flash.c
msgid "Flash now"
msgstr "ثبّت الآن"

#: src/flash.c
msgid ""
"Flash the image now? The running image is replaced and the receiver "
"restarts. Do not switch it off while it flashes."
msgstr ""
"تثبيت الصورة الآن؟ ستُستبدل الصورة الحالية ويُعاد تشغيل الجهاز. لا تُطفئه أثناء "
"التثبيت."

#: src/flash.c
msgid ""
"Clean flash: all settings are lost, after the restart the most recent backup "
"can be restored."
msgstr ""
"تثبيت نظيف: تُفقد كل الإعدادات، ويمكن بعد إعادة التشغيل استعادة أحدث نسخة "
"احتياطية."

#: src/flash.c
msgid ""
"The check only tests the image and writes nothing. After a successful check, "
"OK starts flashing."
msgstr "الفحص يختبر الصورة فقط ولا يكتب شيئًا. بعد نجاح الفحص، يبدأ OK التثبيت."

#: src/flash.c
#, c-format
msgid ""
