msgstr "سجل الأعطال"

#: src/main.c
msgid "There is no log of the last start."
msgstr "لا يوجد سجل لآخر تشغيل."

#: src/main.c
msgid "There is no crash log."
msgstr "لا يوجد سجل أعطال."

#: src/main.c
msgid "Restart Enigma2"
msgstr "إعادة تشغيل Enigma2"

#: src/main.c
msgid "Show crash log"
msgstr "عرض سجل الأعطال"

#: src/main.c
