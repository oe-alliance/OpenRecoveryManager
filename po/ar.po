#: src/main.c
msgid "STARTED FROM THE CONSOLE"
msgstr "تم التشغيل من سطر الأوامر"

#: src/main.c
msgid "Enigma2 is stopped"
msgstr "Enigma2 متوقف"

#: src/main.c
msgid ""
"Recovery Manager runs from a console session. After it ends, Enigma2 can be "
"started again with init 3."
msgstr ""
"يعمل Recovery Manager من جلسة سطر أوامر. بعد إنهائه يمكن إعادة تشغيل Enigma2 "
"باستخدام init 3."

#: src/main.c
msgid "OPENED FROM THE MENU"
msgstr "تم الفتح من القائمة"

#: src/main.c
msgid "Enigma2 is paused"
msgstr "Enigma2 متوقف مؤقتًا"

#: src/main.c
msgid ""
"Recovery Manager was opened from the menu. After it ends, Enigma2 starts "
"again on its own."
msgstr ""
"تم فتح Recovery Manager من القائمة. بعد إنهائه يُعاد تشغيل Enigma2 تلقائيًا."

#: src/main.c
msgid "ENIGMA2 STOPPED RESPONDING WHILE STARTING"
msgstr "توقف Enigma2 عن الاستجابة أثناء التشغيل"

#: src/main.c
msgid "ENIGMA2 STOPPED WITH A PYTHON ERROR SHORTLY AFTER THE START"
msgstr "توقف Enigma2 بسبب خطأ Python بعد التشغيل بقليل"

#: src/main.c
msgid "ENIGMA2 STOPPED WITH A PYTHON ERROR WHILE STARTING"
msgstr "توقف Enigma2 بسبب خطأ Python أثناء التشغيل"

#: src/main.c
msgid "ENIGMA2 CRASHED SHORTLY AFTER THE START"
msgstr "تعطّل Enigma2 بعد التشغيل بقليل"

#: src/main.c
msgid "ENIGMA2 CRASHED WHILE STARTING"
msgstr "تعطّل Enigma2 أثناء التشغيل"

