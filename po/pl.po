#: src/main.c
msgid "STARTED FROM THE CONSOLE"
msgstr "URUCHOMIONO Z KONSOLI"

#: src/main.c
msgid "Enigma2 is stopped"
msgstr "Enigma2 jest zatrzymana"

#: src/main.c
msgid ""
"Recovery Manager runs from a console session. After it ends, Enigma2 can be "
"started again with init 3."
msgstr ""
"Recovery Manager działa w sesji konsoli. Po jego zakończeniu Enigma2 można "
"ponownie uruchomić poleceniem init 3."

#: src/main.c
msgid "OPENED FROM THE MENU"
msgstr "OTWARTO Z MENU"

#: src/main.c
msgid "Enigma2 is paused"
msgstr "Enigma2 jest wstrzymana"

#: src/main.c
msgid ""
"Recovery Manager was opened from the menu. After it ends, Enigma2 starts "
"again on its own."
msgstr ""
"Recovery Manager został otwarty z menu. Po jego zakończeniu Enigma2 uruchomi "
"się ponownie automatycznie."

#: src/main.c
msgid "ENIGMA2 STOPPED RESPONDING WHILE STARTING"
msgstr "ENIGMA2 PRZESTAŁA ODPOWIADAĆ PODCZAS URUCHAMIANIA"

#: src/main.c
msgid "ENIGMA2 STOPPED WITH A PYTHON ERROR SHORTLY AFTER THE START"
msgstr "ENIGMA2 ZATRZYMAŁA SIĘ Z BŁĘDEM PYTHONA ZARAZ PO URUCHOMIENIU"

#: src/main.c
msgid "ENIGMA2 STOPPED WITH A PYTHON ERROR WHILE STARTING"
msgstr "ENIGMA2 ZATRZYMAŁA SIĘ Z BŁĘDEM PYTHONA PODCZAS URUCHAMIANIA"

#: src/main.c
msgid "ENIGMA2 CRASHED SHORTLY AFTER THE START"
msgstr "ENIGMA2 ULEGŁA AWARII ZARAZ PO URUCHOMIENIU"

#: src/main.c
msgid "ENIGMA2 CRASHED WHILE STARTING"
msgstr "ENIGMA2 ULEGŁA AWARII PODCZAS URUCHAMIANIA"

