msgstr "Wyszukiwanie obrazów na nośnikach."

#: src/flash.c
msgid "Images"
msgstr "Obrazy"

#: src/flash.c
msgid "Distribution"
msgstr "Dystrybucja"

#: src/flash.c
msgid "Which distribution should the images come from?"
msgstr "Z której dystrybucji mają pochodzić obrazy?"

#: src/flash.c
#, c-format
msgid "Downloading %s"
msgstr "Pobieranie %s"

#: src/flash.c
#, c-format
msgid "%lld of %lld MB"
msgstr "%lld z %lld MB"

#: src/flash.c
#, c-format
msgid "%lld MB"
msgstr "%lld MB"

#: src/flash.c
#, c-format
msgid "Unzipping %s"
msgstr "Rozpakowywanie %s"

#: src/flash.c
msgid "Check"
msgstr "Sprawdź"

#: src/flash.c
msgid "Please wait, ofgwrite checks the image..."
msgstr "Proszę czekać, ofgwrite sprawdza obraz..."

#: src/flash.c
msgid "the running image"
msgstr "uruchomiony obraz"

#: src/flash.c
#, c-format
msgid "%s (%s on %s), the running image"
msgstr "%s (%s na %s), uruchomiony obraz"

#: src/flash.c
#, c-format
msgid "%s (%s), the running image"
msgstr "%s (%s), uruchomiony obraz"

#: src/flash.c
msgid "Flashing finished, restart the receiver in the menu."
msgstr "Wgrywanie zakończone, uruchom ponownie odbiornik w menu."

#: src/flash.c
#, c-format
msgid "Flashing failed, see %s."
msgstr "Wgrywanie nie powiodło się, zobacz %s."

#: src/flash.c
msgid "ofgwrite wrote nothing."
msgstr "ofgwrite niczego nie zapisał."

#: src/flash.c
msgid "Flashing"
msgstr "Wgrywanie"

#: src/flash.c
msgid "flashed too, kernel A of all slots"
msgstr "również wgrywany, kernel A wszystkich slotów"

#: src/flash.c
#, c-format
msgid "flashed too (%s)"
msgstr "również wgrywany (%s)"

#: src/flash.c
msgid "flashed too"
msgstr "również wgrywany"

#: src/flash.c
msgid "stays as it is"
msgstr "pozostaje bez zmian"

#: src/flash.c
msgid "Image"
msgstr "Obraz"

#: src/flash.c
msgid "Location"
msgstr "Lokalizacja"

#: src/flash.c
msgid "Slot"
msgstr "Slot"

#: src/flash.c
msgid "Kernel"
msgstr "Kernel"

#: src/flash.c
msgid "Command"
msgstr "Polecenie"

#: src/flash.c
msgid "The check was successful"
msgstr "Sprawdzanie zakończone powodzeniem"

#: src/flash.c
msgid "The check failed"
msgstr "Sprawdzanie nie powiodło się"

#: src/flash.c
msgid "Flash now"
msgstr "Wgraj teraz"

#: src/flash.c
msgid ""
"Flash the image now? The running image is replaced and the receiver "
"restarts. Do not switch it off while it flashes."
msgstr ""
"Wgrać obraz teraz? Uruchomiony obraz zostanie zastąpiony, a odbiornik "
"uruchomi się ponownie. Nie wyłączaj go podczas wgrywania."

#: src/flash.c
msgid ""
"Clean flash: all settings are lost, after the restart the most recent backup "
"can be restored."
msgstr ""
"Czyste wgranie: wszystkie ustawienia zostaną utracone, po ponownym "
"uruchomieniu można przywrócić najnowszą kopię zapasową."

#: src/flash.c
msgid ""
"The check only tests the image and writes nothing. After a successful check, "
"OK starts flashing."
msgstr ""
"Sprawdzanie tylko testuje obraz i niczego nie zapisuje. Po udanym "
"sprawdzeniu OK rozpoczyna wgrywanie."

#: src/flash.c
#, c-format
msgid ""
"There is not enough free space on %s, it needs %lld MB. YELLOW frees up "
"space."
msgstr ""
"Za mało wolnego miejsca na %s, potrzeba %lld MB. ŻÓŁTY zwalnia miejsce."

#: src/flash.c src/backup.c src/files.c
msgid "Free up space"
msgstr "Zwolnij miejsce"

#: src/flash.c
#, c-format
msgid "There is not enough free space on %s, it needs %lld MB."
msgstr "Za mało wolnego miejsca na %s, potrzeba %lld MB."

#: src/flash.c
msgid "The image could not be downloaded."
msgstr "Nie można pobrać obrazu."

#: src/flash.c
msgid "The image could not be unzipped or holds no image for ofgwrite."
msgstr "Nie można rozpakować obrazu lub nie zawiera on obrazu dla ofgwrite."

#: src/flash.c
msgid "Loading the list of distributions."
msgstr "Wczytywanie listy dystrybucji."

#: src/flash.c
msgid "Close"
msgstr "Zamknij"

#: src/flash.c
msgid "The chosen image replaces the running image."
