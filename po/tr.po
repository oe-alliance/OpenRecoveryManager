#: src/flash.c
msgid "Distribution"
msgstr "Dağıtım"

#: src/flash.c
msgid "Which distribution should the images come from?"
msgstr "İmajlar hangi dağıtımdan alınsın?"

#: src/flash.c
#, c-format
