msgstr "%s indiriliyor"

#: src/flash.c
#, c-format
msgid "%lld of %lld MB"
msgstr "%lld / %lld MB"

#: src/flash.c
#, c-format
msgid "%lld MB"
msgstr "%lld MB"

#: src/flash.c
#, c-format
msgid "Unzipping %s"
msgstr "%s dosyası açılıyor"

#: src/flash.c
msgid "Check"
msgstr "Kontrol et"

#: src/flash.c
msgid "Please wait, ofgwrite checks the image..."
msgstr "Lütfen bekleyin, ofgwrite imajı kontrol ediyor..."

#: src/flash.c
msgid "the running image"
msgstr "çalışan imaj"

#: src/flash.c
#, c-format
msgid "%s (%s on %s), the running image"
msgstr "%s (%s, %s üzerinde), çalışmakta olan imaj"

#: src/flash.c
#, c-format
msgid "%s (%s), the running image"
msgstr "%s (%s), çalışmakta olan imaj"

#: src/flash.c
msgid "Flashing finished, restart the receiver in the menu."
msgstr "Flaşlama tamamlandı. Alıcı cihazı menüden yeniden başlatın."

#: src/flash.c
#, c-format
msgid "Flashing failed, see %s."
msgstr "Flaşlama başarısız oldu, %s dosyasına bakın."

#: src/flash.c
msgid "ofgwrite wrote nothing."
msgstr "ofgwrite hiçbir şey yazmadı."

#: src/flash.c
msgid "Flashing"
msgstr "Flaşlanıyor"

#: src/flash.c
msgid "flashed too (kernel.img on the Dreamcard)"
msgstr "birlikte flaşlanır (Dreamcard üzerinde kernel.img)"

#: src/flash.c
msgid "flashed too (kernel.img in /boot)"
msgstr "birlikte flaşlanır (/boot içinde kernel.img)"

#: src/flash.c
msgid "flashed too, kernel A of all slots"
msgstr "tüm yuvaların A Kernel,i birlikte flaşlanır"

#: src/flash.c
#, c-format
msgid "flashed too (%s)"
msgstr "birlikte flaşlanır (%s)"

#: src/flash.c
msgid "flashed too"
msgstr "birlikte flaşlanır"

#: src/flash.c
msgid "stays as it is"
msgstr "değişmeden kalır"

#: src/flash.c
msgid "Image"
msgstr "İmaj"

#: src/flash.c
msgid "Location"
msgstr "Konum"

#: src/flash.c
msgid "Slot"
msgstr "Yuva"

#: src/flash.c
msgid "Kernel"
msgstr "Çekirdek"

#: src/flash.c
msgid "Command"
msgstr "Komut"

#: src/flash.c
msgid "The check was successful"
msgstr "Kontrol başarıyla tamamlandı"

#: src/flash.c
msgid "The check failed"
msgstr "Kontrol başarısız oldu"

#: src/flash.c
msgid "Flash now"
msgstr "Şimdi flaşla"

#: src/flash.c
msgid ""
"Flash the image now? The running image is replaced and the receiver "
"restarts. Do not switch it off while it flashes."
msgstr ""
"İmaj şimdi flaşlansın mı? Çalışmakta olan imaj değiştirilecek ve alıcı cihaz "
"yeniden başlatılacak. Flaşlama sırasında cihazı kapatmayın."

#: src/flash.c
msgid ""
"Clean flash: all settings are lost, after the restart the most recent backup "
"can be restored."
msgstr ""
"Temiz flaşlama: Tüm ayarlar silinir. Yeniden başlatmanın ardından en son "
"yedek geri yüklenebilir."

#: src/flash.c
msgid ""
"The check only tests the image and writes nothing. After a successful check, "
"OK starts flashing."
